# 本地开发环境变量配置
# 复制此文件为 .env.local 并填入实际值

# Database (连接到Docker中的PostgreSQL)
DATABASE_URL="postgresql://txt2voice:txt2voice_password@localhost:5432/txt2voice"

# Redis (连接到Docker中的Redis)
REDIS_URL="redis://localhost:6379"

# Next.js
NEXTAUTH_SECRET="change-this-secret-key-in-production"
NEXTAUTH_URL="http://localhost:3000"

# TTS Provider
QWEN3VOICE_API_URL="http://192.168.88.9:18080"
VOXCPM_API_URL="http://192.168.88.9:18083"
VOXCPM_TIMEOUT=300000

# File Storage
UPLOAD_DIR="./uploads"
AUDIO_DIR="./uploads"

# Application Settings
NODE_ENV="development"
PORT=3000
# Task Queue Namespace
# 本地同时运行多个实例时必须唯一，避免 Redis 队列互相抢任务
TASK_QUEUE_NAMESPACE="txt2voice:3000"

# LLM Model Registry Fallback Configuration
# 主入口是产品内的 /settings/llm；只有数据库里没有配置时才会回退到这些环境变量
# 若本地 Qwen 服务不校验密钥，apiKey 也可留空，但建议保留占位符，便于调试 SDK 行为
LLM_DEFAULT_MODEL_ID="qwen-local"
LLM_MODELS_JSON='[{"id":"deepseek-cloud","label":"DeepSeek Cloud","provider":"custom","apiKey":"your-llm-api-key-here","baseURL":"https://api.deepseek.com/v1","model":"deepseek-chat"},{"id":"qwen-local","label":"Qwen Local","provider":"custom","apiKey":"local-placeholder-key","baseURL":"http://192.168.88.9:8028/v1","model":"Qwen3.5-9B-GGUF-Q4_K_M"}]'

# Legacy single-model fallback (仍然支持，但仅建议用于迁移或应急)
LLM_PROVIDER="custom"
LLM_API_KEY="your-llm-api-key-here"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"
