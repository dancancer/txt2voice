# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Database
DATABASE_URL="postgresql://user:password@host:5432/txt2voice"

# Redis
REDIS_URL="redis://host:6379"

# Next.js
NEXTAUTH_SECRET="your-secret-key-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# TTS Providers
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="your-azure-region"

# File Storage
UPLOAD_DIR="./uploads"
AUDIO_DIR="./audio"

# Application Settings
NODE_ENV="development"
PORT=3000
# Task Queue Namespace
# 多实例（如本地 + Docker）并行时必须使用不同命名空间
TASK_QUEUE_NAMESPACE="txt2voice:3000"

# LLM Model Registry Fallback Configuration
# 主入口是产品内的 /settings/llm；只有数据库里没有配置时才会回退到这里
LLM_DEFAULT_MODEL_ID="qwen-local"
LLM_MODELS_JSON='[{"id":"deepseek-cloud","label":"DeepSeek Cloud","provider":"custom","apiKey":"your-llm-api-key-here","baseURL":"https://api.deepseek.com/v1","model":"deepseek-chat"},{"id":"qwen-local","label":"Qwen Local","provider":"custom","apiKey":"local-placeholder-key","baseURL":"http://192.168.88.9:8028/v1","model":"Qwen3.5-9B-GGUF-Q4_K_M"}]'

# Legacy single-model fallback
LLM_PROVIDER="custom"
LLM_API_KEY="your-llm-api-key-here"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# IndexTTS Configuration
INDEXTTS_API_URL="http://192.168.88.9:8001"
INDEXTTS_API_KEY=""
INDEXTTS_TIMEOUT="30000"
INDEXTTS_MAX_FILE_SIZE="104857600"

# CosyVoice Configuration
COSYVOICE_API_URL="http://192.168.88.9:8011"
COSYVOICE_TIMEOUT="120000"
COSYVOICE_DEFAULT_MODE="cross_lingual"

# VoxCPM Configuration
VOXCPM_API_URL="http://192.168.88.9:8012"
VOXCPM_TIMEOUT="120000"

# Public IndexTTS URL (for client-side audio playback)
NEXT_PUBLIC_INDEXTTS_API_URL="http://192.168.88.9:8001"
