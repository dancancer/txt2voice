# Development Dockerfile for Next.js with hot reload support
FROM node:20-alpine

WORKDIR /app

# Install ffmpeg for audio merging functionality
RUN apk add --no-cache ffmpeg

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy workspace configuration files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/

# Install all dependencies (including dev dependencies)
RUN pnpm install --filter=web... --no-frozen-lockfile

WORKDIR /app/apps/web

# Expose port
EXPOSE 3001

ENV PORT 3001
ENV HOSTNAME "0.0.0.0"
ENV NODE_ENV development
ENV NEXT_TELEMETRY_DISABLED 1

CMD ["sh", "-lc", "pnpm prisma generate && pnpm next dev --webpack --hostname 0.0.0.0 -p 3001"]
